# PostgreSQL 连接字符串
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA"

# 服务端口
PORT=3000

# 运行环境：development | production
NODE_ENV=development

# CORS 允许来源（逗号分隔）
# 生产环境必填，缺失或留空会导致启动直接失败；非生产环境留空则允许所有来源（仅限本地开发）。
CORS_ORIGIN=http://localhost:5173

# JWT 签名密钥（必填，长度 >= 32）
# ↓ 下面这行是刻意留的无效占位值：它在 env.ts 的 INSECURE_JWT_SECRETS 黑名单里，
#   直接 cp .env.example .env 后启动会立即失败，以此强制你换成真实随机密钥。
#   生成方式：openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ===== 七牛云对象存储 =====
# AccessKey / SecretKey：在七牛控制台「密钥管理」获取
QINIU_ACCESS_KEY=your-access-key
QINIU_SECRET_KEY=your-secret-key

# 存储空间名（Bucket）
QINIU_BUCKET=your-bucket-name

# 存储区域：z0(华东-浙江) | z1(华北) | z2(华南) | na0(北美) | as0(东南亚) | cn-east-2(华东-浙江2)
# 必须与 Bucket 实际所在区域一致，否则删除/查询会指向错误服务节点
QINIU_REGION=z2

# 存储空间绑定的访问域名（公开空间直接拼接 key 即可访问）
# 可带或不带 http(s):// 前缀，末尾不要加斜杠
QINIU_DOMAIN=https://your-cdn-domain.com