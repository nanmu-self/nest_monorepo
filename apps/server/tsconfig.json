{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,

    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
