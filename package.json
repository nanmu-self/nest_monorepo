{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "predev": "pnpm --filter @app/shared --filter @app/config-tailwind --filter @app/ui build",
    "dev": "pnpm --parallel --filter @app/shared --filter @app/config-tailwind --filter @app/ui --filter @app/server --filter @app/web-admin dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.0.0",
    "prettier": "^3.4.0",
    "typescript": "~5.8.0"
  }
}
