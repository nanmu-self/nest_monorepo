{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-private-class-members": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["apps/background/**"],
      "plugins": ["react"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/only-export-components": ["warn", { "allowConstantExport": true }]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-ssr/**",
    "**/node_modules/**",
    "**/*.config.js",
    "**/*.config.mjs",
    "**/*.config.ts"
  ]
}
