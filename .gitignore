# --- Avoid nested VCS inside a workspace package (defensive) ---
**/packages/**/.git/
**/apps/**/.git/

# --- Defensive: TS source-only packages should not contain emitted .js files ---
**/packages/*/src/**/*.js
**/packages/*/src/**/*.js.map
**/packages/*/src/**/*.d.ts

