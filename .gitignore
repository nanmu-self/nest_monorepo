# 本仓库自身的忽略规则。
# 注意：这份文件不进 npm 包（package.json#files 白名单未列出它）；
# 生成项目用的 .gitignore 在 template/gitignore（manifest 的 dest 映射回 .gitignore）。
# 改模板忽略规则请改那份，两份需人工保持同步。

# Dependencies / build
node_modules/
dist/
*.tsbuildinfo
.oxlintcache

# Prisma 7 时代的生成目录（v8 已改为 contract 契约产物，需提交）
generated/

# Env secrets（绝不提交）
.env
.env.*
!.env.example

# Logs / coverage / temp
logs/
*.log
coverage/
.temp
.tmp
.cache

# Pkg tarballs
*.tgz

# OS / IDE
.DS_Store
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Local tooling
.codegraph/
.zcode/

# create-nest-monorepo prepack 物化产物（postpack 会删；中断时防误提交）
template/apps/
template/packages/
